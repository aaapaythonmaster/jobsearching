# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database
# Demo (default): sqlite, single file, zero-setup. Tables auto-created on boot.
DB_DIALECT=sqlite
DB_SQLITE_FILE=./data/dev.db

# Production: switch to postgres and run `npm run db:migrate` before `npm start`.
# DB_DIALECT=postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/vibecoding

# AI
# DeepSeek-compatible chat completions. Keep the real key in backend/.env only.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=sk-...
