# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Production only: exact Vercel frontend URL, for example https://your-project.vercel.app
# CORS_ORIGIN=https://your-project.vercel.app

# Database
# Demo (default): sqlite, single file, zero-setup. Tables auto-created on boot.
DB_DIALECT=sqlite
DB_SQLITE_FILE=./data/dev.db

# Production: switch to postgres and run `npm run db:migrate` before `npm start`.
# DB_DIALECT=postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/vibecoding

# AI
# Zhipu AI OpenAI-compatible chat completions. Keep the real key in backend/.env only.
AI_PROVIDER=zhipu
AI_MODEL=glm-5.2
AI_OCR_MODEL=glm-ocr
AI_BASE_URL=https://api.z.ai/api/paas/v4
# Optional when terminal/Node cannot reach the AI provider directly.
# AI_PROXY_URL=http://127.0.0.1:7897
# AI_API_KEY=...
